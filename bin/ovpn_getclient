#!/bin/bash

#
# Get an OpenVPN client configuration file
#

# Never trace commands that expand private keys into the exported profile.
set +x

set -e
umask 077

if [ -z "$OPENVPN" ]; then
    export OPENVPN="$PWD"
fi
if ! source "$OPENVPN/ovpn_env.sh"; then
    echo "Could not source $OPENVPN/ovpn_env.sh."
    exit 1
fi
if [ -z "$EASYRSA_PKI" ]; then
    export EASYRSA_PKI="$OPENVPN/pki"
fi

cn="$1"
parm="$2"

case "${OVPN_IPV6:-block}" in
    block|route) ;;
    *) echo "Invalid saved IPv6 policy" >&2; exit 1 ;;
esac

case "$cn" in
    ''|.|..|*/*) echo "Invalid client name" >&2; exit 1 ;;
esac

if [ ! -f "$EASYRSA_PKI/private/${cn}.key" ]; then
    echo "Unable to find \"${cn}\", please try again or generate the key first" >&2
    exit 1
fi

get_client_config() {
    mode="$1"
    echo "
client
nobind
dev $OVPN_DEVICE
remote-cert-tls server

remote $OVPN_CN $OVPN_PORT $OVPN_PROTO"
    if [ "$OVPN_PROTO" == "udp6" ]; then
        echo "remote $OVPN_CN $OVPN_PORT udp"
    fi
    if [ "$OVPN_PROTO" == "tcp6" ]; then
        echo "remote $OVPN_CN $OVPN_PORT tcp"
    fi
    for i in "${OVPN_EXTRA_CLIENT_CONFIG[@]}"; do
      echo "$i"
    done
    if [ "$mode" == "combined" ]; then
        echo "
<key>
$(cat "$EASYRSA_PKI/private/${cn}.key")
</key>
<cert>
$(openssl x509 -in "$EASYRSA_PKI/issued/${cn}.crt")
</cert>
<ca>
$(cat "$EASYRSA_PKI/ca.crt")
</ca>
key-direction 1
<tls-auth>
$(cat "$EASYRSA_PKI/ta.key")
</tls-auth>
"
    elif [ "$mode" == "separated" ]; then
        echo "
key ${cn}.key
ca ca.crt
cert ${cn}.crt
tls-auth ta.key 1
"
    fi

    if [ "$OVPN_DEFROUTE" != "0" ];then
        echo "redirect-gateway def1 ipv6"
        if [ "${OVPN_IPV6:-block}" == block ]; then
            # Route IPv6 into OpenVPN before rejecting it; block-ipv6 alone
            # does not stop native IPv6 traffic bypassing an IPv4-only tunnel.
            echo "ifconfig-ipv6 fd15:53b6:dead::2/64 fd15:53b6:dead::1"
            echo "block-ipv6"
            # DCO bypasses the userspace handler that sends IPv6 rejections.
            # Client-side fallback does not disable server-side offload.
            echo "disable-dco"
        fi
    fi

    if [ -n "$OVPN_MTU" ]; then
        echo "tun-mtu $OVPN_MTU"
    fi

    if [ -n "$OVPN_SNDBUF" ]; then
        echo "sndbuf $OVPN_SNDBUF"
    fi

    if [ -n "$OVPN_RCVBUF" ]; then
        echo "rcvbuf $OVPN_RCVBUF"
    fi

    if [ "$OVPN_FAST_IO" == "1" ] && [[ "$OVPN_PROTO" == udp* ]]; then
        echo "fast-io"
    fi

    if [ -n "$OVPN_TLS_CIPHER" ]; then
        echo "tls-cipher $OVPN_TLS_CIPHER"
    fi

    if [ -n "$OVPN_CIPHER" ]; then
        echo "#cipher $OVPN_CIPHER"
        echo "data-ciphers $OVPN_CIPHER"
    fi

    if [ -n "$OVPN_AUTH" ]; then
        echo "auth $OVPN_AUTH"
    fi

    if [ -n "$OVPN_OTP_AUTH" ]; then
        echo "auth-user-pass"
        echo "auth-nocache"
    fi

    if [ "${OVPN_PROFILE:-legacy}" == dco ]; then
        echo "allow-compression no"
    elif [ "$OVPN_COMP_LZO" == "1" ]; then
        echo "comp-lzo"
    fi

    if [ -n "$OVPN_OTP_AUTH" ]; then
        echo reneg-sec 0
    fi
}

dir="$OPENVPN/clients/$cn"
tmp_export=''
trap 'rm -f -- "${tmp_export:-}"' EXIT

prepare_export_dir() {
    local path
    for path in "$OPENVPN/clients" "$dir"; do
        if [ -L "$path" ]; then
            echo "Refusing symlink export directory: $path" >&2; exit 1
        fi
        mkdir -p "$path"
        if [ ! -O "$path" ]; then
            echo "Export directory must be owned by the exporting user: $path" >&2; exit 1
        fi
        chmod 700 "$path"
    done
}

# Replace existing files atomically instead of following symlinks or changing
# the modes of hard-linked keys. The parent directory is private and owned.
save_export() {
    local target="$1"
    shift
    if [ -L "$target" ] || { [ -e "$target" ] && [ ! -f "$target" ]; }; then
        echo "Refusing non-regular export target: $target" >&2; exit 1
    fi
    tmp_export=$(mktemp "$dir/.export.XXXXXX")
    "$@" > "$tmp_export"
    chmod 600 "$tmp_export"
    mv -f "$tmp_export" "$target"
    tmp_export=''
}

case "$parm" in
    "separated")
        prepare_export_dir
        save_export "$dir/${cn}.ovpn" get_client_config "$parm"
        save_export "$dir/${cn}.key" cat "$EASYRSA_PKI/private/${cn}.key"
        save_export "$dir/ca.crt" cat "$EASYRSA_PKI/ca.crt"
        save_export "$dir/${cn}.crt" cat "$EASYRSA_PKI/issued/${cn}.crt"
        save_export "$dir/ta.key" cat "$EASYRSA_PKI/ta.key"
        ;;
    "" | "combined")
        get_client_config "combined"
        ;;
    "combined-save")
        prepare_export_dir
        save_export "$dir/${cn}-combined.ovpn" get_client_config combined
        ;;
    *)
        echo "This script can produce the client configuration in two formats:" >&2
        echo "    1. combined (default): All needed configuration and cryptographic material is in one file (Use \"combined-save\" to write the configuration file in the same path as the separated parameter does)." >&2
        echo "    2. separated: Separated files." >&2
        echo "Please specify one of those options as second parameter." >&2
        ;;
esac
